[Unit]
Description=RPIs backend ping publisher
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/TechtileDashboard/pythonBackend
ExecStart=/usr/bin/python3 /home/pi/TechtileDashboard/pythonBackend/rpis_control.py
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
